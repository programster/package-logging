{
    "name": "programster/log",
    "type": "library",
    "description": "A library of loggers that comply with PSR-3",
    "keywords": ["log", "logging", "logger", "psr-3", "failover"],
    "homepage": "https://github.com/programster/package-logging",
    "license": "MIT",
    "authors": [
        {
            "name": "Stuart Page",
            "homepage": "https://blog.programster.org"
        }
    ],
    "require": {
        "php": "^8.2",
        "programster/collections": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Programster\\Log\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Programster\\Log\\Testing\\": "testing/"
        }
    },
    "scripts": {
        "test": "php -d zend.assertions=1 -d assert.exception=1 testing/main.php"
    }
}
